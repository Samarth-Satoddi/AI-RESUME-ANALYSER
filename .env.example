# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Resume Analyzer & Job Opportunity Matcher"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
JWT_SECRET_KEY=change-this-to-a-super-secret-jwt-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resume_analyzer_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer_db
# For SQLite local file testing (without Docker/PostgreSQL):
# DATABASE_URL=sqlite:///./resume_analyzer.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI Provider Configuration
# Supported providers: heuristic (offline/rule-based), openai, anthropic
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Job Search Agent
JOB_SEARCH_ENABLED=true
JOB_SEARCH_PROVIDER=mock
JOB_SEARCH_API_KEY=
JOB_SEARCH_API_URL=
JOB_SEARCH_MAX_RESULTS=100
JOB_SEARCH_TIMEOUT_SECONDS=30
JOB_SEARCH_CACHE_TTL=900

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
